# Gold Intelligence Trading System - environment template.
# Copy to .env and edit. Never commit a .env containing broker credentials.

# analysis | paper | live   (live is only armed if every checklist item passes AND a ready broker adapter exists)
# paper = analysis + simulated trading (the chosen operating mode)
APP_MODE=paper
# intraday: D1/H4 direction, H1 confirm, M15 entry, 24h max hold
# scalping: H4/H1 direction, M15 confirm+entry, 4h max hold
STRATEGY_PROFILE=intraday
INSTRUMENT=XAUUSD
ACCOUNT_EQUITY=100000

# --- Live-execution checklist (all default to safe values) ---
LIVE_TRADING_AUTHORIZED=false
BROKER_CONNECTED=false
EMERGENCY_SHUTDOWN_ARMED=true
BROKER_ADAPTER=none

# --- Storage (optional; JSON-lines journal is used when empty) ---
DATABASE_URL=
REDIS_URL=

# --- MetaTrader 5 (optional, read-only data feed; Windows + MT5 terminal) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_SYMBOL=XAUUSD

# --- Risk limits (operator-controlled; the learning module cannot write these) ---
MAX_RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=2.0
MAX_WEEKLY_DRAWDOWN_PCT=5.0
MAX_OPEN_POSITIONS=1
MAX_CORRELATED_EXPOSURE_PCT=0.5
MAX_SPREAD=0.50
MAX_SLIPPAGE=0.30
MIN_REWARD_RISK=1.8
MAX_CONSECUTIVE_LOSSES=3
ALLOWED_SESSIONS=london,new_york,london_new_york_overlap
MACRO_BLACKOUT_BEFORE_MIN=30
MACRO_BLACKOUT_AFTER_MIN=15
MIN_SIGNAL_CONFIDENCE=62
# Spread may use at most this share of the stop distance
MAX_SPREAD_STOP_RATIO=0.2

# --- NFP & CPI protection (tier-1 releases) ---
# No new trades from BEFORE minutes ahead of the release until AFTER minutes past it.
TIER1_BLACKOUT_BEFORE_MIN=60
TIER1_BLACKOUT_AFTER_MIN=60
# Close open simulated trades this many minutes before NFP/CPI (0 = keep them open).
FLATTEN_BEFORE_TIER1_MIN=15
# Optional JSON calendar feed with confirmed dates (ForexFactory-style rows:
# title, country, date, impact, forecast, previous). Empty = CSV file + built-in schedule.
# Example: https://nfs.faireconomy.media/ff_calendar_thisweek.json
CALENDAR_FEED_URL=
CALENDAR_REFRESH_MINUTES=60

# --- Optional macro context supplied by an authorized feed ---
DXY_SESSION_CHANGE=
US10Y_SESSION_CHANGE=

# --- Contract specification (confirm with your broker) ---
CONTRACT_OUNCES=100
MIN_LOT=0.01
LOT_STEP=0.01

# --- API ---
CORS_ORIGINS=http://localhost:5173
STREAM_INTERVAL_SECONDS=15

# --- Automation ---
# Seconds between background cycles (refresh data, mark paper, evaluate on each new bar). 0 disables.
AUTO_CYCLE_SECONDS=60
