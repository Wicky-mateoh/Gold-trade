# Gold Intelligence Trading System - environment template.
# Copy to .env and edit. Never commit a .env containing broker credentials.

# analysis | paper | live   (live is only armed if every checklist item passes AND a ready broker adapter exists)
# paper = analysis + simulated trading (the chosen operating mode)
APP_MODE=paper
# intraday: D1/H4 direction, H1 confirm, M15 entry, 24h max hold
# scalping: H4/H1 direction, M15 confirm+entry, 4h max hold
STRATEGY_PROFILE=intraday
INSTRUMENT=XAUUSD
ACCOUNT_EQUITY=100000

# --- Live execution (all default to safe values) ---
# Stage 3 (demo account, real orders): BROKER_ADAPTER=mt5, LIVE_TRADING_AUTHORIZED=true,
# MT5 logged in with the MASTER (trading) password, Algo Trading button on in MT5,
# then press "live" on the dashboard. Orders only go to DEMO accounts unless ALLOW_REAL_ACCOUNT=true.
LIVE_TRADING_AUTHORIZED=false
BROKER_CONNECTED=false
EMERGENCY_SHUTDOWN_ARMED=true
# none | mt5
BROKER_ADAPTER=none
# Real-money accounts are refused unless this is true. Leave false until the demo stage has passed.
ALLOW_REAL_ACCOUNT=false
# Hard cap on lots per live order, applied after the risk sizing (0.01 = about $1 per $1 gold move).
LIVE_MAX_LOTS=0.01
# Magic number that tags this bot's orders in MT5 (change only if it clashes with another EA).
LIVE_MAGIC=7319001

# --- Storage (optional; JSON-lines journal is used when empty) ---
DATABASE_URL=
REDIS_URL=

# --- Market data source ---
# auto = data/<MT5_SYMBOL>_M5.csv if it exists, else MT5 (if configured), else synthetic demo
# mt5  = always use the MT5 terminal (fails loudly if it cannot connect)
# csv  = always use the CSV file
DATA_SOURCE=auto

# --- MetaTrader 5 (read-only price feed; Windows + MT5 terminal + pip install MetaTrader5) ---
# Account number, password, and the server name exactly as shown in MT5 (File > Login to Trade Account).
# An investor (read-only) password is enough: the bot only reads prices.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Your broker's exact gold symbol (e.g. XAUUSD, XAUUSDm, GOLD, XAUUSD.r). scripts/check_mt5.py lists them.
MT5_SYMBOL=XAUUSD
# Only if several MT5 terminals are installed, e.g. C:\Program Files\MetaTrader 5\terminal64.exe
MT5_TERMINAL_PATH=
# M5 bars to load (100000 ~ 1.4 years). Raise MT5 Tools > Options > Charts > Max bars in chart to match.
MT5_HISTORY_BARS=100000
# Broker server time minus UTC in hours (often 2 or 3). Empty = detect from the live price.
MT5_SERVER_UTC_OFFSET_HOURS=

# --- Risk limits (operator-controlled; the learning module cannot write these) ---
MAX_RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=2.0
MAX_WEEKLY_DRAWDOWN_PCT=5.0
MAX_OPEN_POSITIONS=1
MAX_CORRELATED_EXPOSURE_PCT=0.5
MAX_SPREAD=0.50
MAX_SLIPPAGE=0.30
MIN_REWARD_RISK=1.8
MAX_CONSECUTIVE_LOSSES=3
ALLOWED_SESSIONS=london,new_york,london_new_york_overlap
MACRO_BLACKOUT_BEFORE_MIN=30
MACRO_BLACKOUT_AFTER_MIN=15
MIN_SIGNAL_CONFIDENCE=62
# Spread may use at most this share of the stop distance
MAX_SPREAD_STOP_RATIO=0.2

# --- NFP & CPI protection (tier-1 releases) ---
# No new trades from BEFORE minutes ahead of the release until AFTER minutes past it.
TIER1_BLACKOUT_BEFORE_MIN=60
TIER1_BLACKOUT_AFTER_MIN=60
# Close open simulated trades this many minutes before NFP/CPI (0 = keep them open).
FLATTEN_BEFORE_TIER1_MIN=15
# Optional JSON calendar feed with confirmed dates (ForexFactory-style rows:
# title, country, date, impact, forecast, previous). Empty = CSV file + built-in schedule.
# Example: https://nfs.faireconomy.media/ff_calendar_thisweek.json
CALENDAR_FEED_URL=
CALENDAR_REFRESH_MINUTES=60

# --- Optional macro context supplied by an authorized feed ---
DXY_SESSION_CHANGE=
US10Y_SESSION_CHANGE=

# --- Contract specification (confirm with your broker) ---
CONTRACT_OUNCES=100
MIN_LOT=0.01
LOT_STEP=0.01

# --- API ---
CORS_ORIGINS=http://localhost:5173
STREAM_INTERVAL_SECONDS=15

# --- Automation ---
# Seconds between background cycles (refresh data, mark paper, evaluate on each new bar). 0 disables.
AUTO_CYCLE_SECONDS=60
